// RUN: cudaq-translate --convert-to=openqasm2 %s | FileCheck %s

// Models the unrolled shape of a loop-local, write-only classical list that
// receives a measurement result each iteration:
//
//   for i in range(2):
//       res = [False, False]
//       h(q[i])
//       res[i] = mz(q[i])
//
// stack-frame-prealloc must run in the OpenQASM translation pipeline for
// this to translate cleanly: without it, the scope lowering left behind by
// lower-to-cfg leaves values the Emitter cannot name.
func.func @loop_local_write_only_list() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %c2 = arith.constant 2 : i64
  %veq = quake.alloca !quake.veq<2>
  %false = arith.constant false
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64

  cc.scope {
    %res = cc.alloca i1[%c2 : i64]
    %p0 = cc.compute_ptr %res[0] : (!cc.ptr<!cc.array<i1 x ?>>) -> !cc.ptr<i1>
    cc.store %false, %p0 : !cc.ptr<i1>
    %p1 = cc.compute_ptr %res[1] : (!cc.ptr<!cc.array<i1 x ?>>) -> !cc.ptr<i1>
    cc.store %false, %p1 : !cc.ptr<i1>
    %q0 = quake.extract_ref %veq[%c0] : (!quake.veq<2>, i64) -> !quake.ref
    quake.h %q0 : (!quake.ref) -> ()
    %m0 = quake.mz %q0 : (!quake.ref) -> !quake.measure
    %bit0 = quake.discriminate %m0 : (!quake.measure) -> i1
    %elt0 = cc.compute_ptr %res[%c0] : (!cc.ptr<!cc.array<i1 x ?>>, i64) -> !cc.ptr<i1>
    cc.store %bit0, %elt0 : !cc.ptr<i1>
  }
  cc.scope {
    %res = cc.alloca i1[%c2 : i64]
    %p0 = cc.compute_ptr %res[0] : (!cc.ptr<!cc.array<i1 x ?>>) -> !cc.ptr<i1>
    cc.store %false, %p0 : !cc.ptr<i1>
    %p1 = cc.compute_ptr %res[1] : (!cc.ptr<!cc.array<i1 x ?>>) -> !cc.ptr<i1>
    cc.store %false, %p1 : !cc.ptr<i1>
    %q1 = quake.extract_ref %veq[%c1] : (!quake.veq<2>, i64) -> !quake.ref
    quake.h %q1 : (!quake.ref) -> ()
    %m1 = quake.mz %q1 : (!quake.ref) -> !quake.measure
    %bit1 = quake.discriminate %m1 : (!quake.measure) -> i1
    %elt1 = cc.compute_ptr %res[%c1] : (!cc.ptr<!cc.array<i1 x ?>>, i64) -> !cc.ptr<i1>
    cc.store %bit1, %elt1 : !cc.ptr<i1>
  }
  return
}

// CHECK: qreg var0[2];
// CHECK-NEXT: h var0[0];
// CHECK: measure var0[0] ->
// CHECK: h var0[1];
// CHECK: measure var0[1] ->
